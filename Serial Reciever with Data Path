module top_module(
    input clk,
    input in,
    input reset,    // Synchronous reset
    output [7:0] out_byte,
    output done
); //

    // Use FSM from Fsm_serial
    
    reg[3:0] count; 
    
    reg[3:0] state, next_state;
    
    reg[7:0] outputbit;
    
    
    
    localparam IDLE = 3'd0, DATA = 3'd1, STOP = 3'd2, DONE = 3'd3, ERR = 3'd4;
    
    
    always@(*) begin
        case(state) 
            IDLE : next_state <= in ? IDLE : DATA;
            DATA: next_state <= (count == 7) ? STOP : DATA;
            STOP: next_state <= in ? DONE : ERR;
            DONE : next_state <= in ? IDLE : DATA;
            ERR: next_state <= in ? IDLE : ERR;
        endcase
        
    end

    
    
    always@(posedge clk) begin
        if(reset) begin
            state <= IDLE;
        end else begin
            state <= next_state;
            count <= (state == DATA) ? count + 1 : 0;
            if(state == DATA) begin
                outputbit[count] <= in;
            end else begin
                out_byte <= outputbit;
                outputbit <= 0;
            end
            
        end
    end
        
    assign done = state == DONE;   
    
    
    // New: Datapath to latch input bits.

    
endmodule
